#!/bin/sh
set -u

base_url="${BOTIFIED_BASE_URL:-http://127.0.0.1:17777}"
service_key="${BOTIFIED_SERVICE_KEY:-}"
curl_bin="${BOTIFIED_CURL:-curl}"

base_url=${base_url%/}

usage() {
	cat <<'EOF'
usage: botified-chat

Interactive curl-based test client for a running Botified service.

Environment:
  BOTIFIED_BASE_URL      Service URL. Default: http://127.0.0.1:17777
  BOTIFIED_SERVICE_KEY   Optional bearer token.
  BOTIFIED_CURL          Optional curl binary path. Default: curl

Commands:
  /quit, /exit           Exit the loop.
EOF
}

log() {
	printf 'botified-chat: %s\n' "$*" >&2
}

check_curl() {
	command -v "$curl_bin" >/dev/null 2>&1 || {
		log "curl command not found: $curl_bin"
		exit 127
	}
}

json_escape() {
	awk '
		BEGIN { ORS = "" }
		{
			gsub(/\\/, "\\\\")
			gsub(/"/, "\\\"")
			gsub(/\t/, "\\t")
			gsub(/\r/, "\\r")
			if (NR > 1) {
				printf "\\n"
			}
			printf "%s", $0
		}
	'
}

json_string_field() {
	field=$1
	sed -n "s/.*\"$field\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | sed -n '1p'
}

post_message() {
	body=$1
	if [ -n "$service_key" ]; then
		"$curl_bin" -fsS -X POST "$base_url/v1/messages" \
			-H "Authorization: Bearer $service_key" \
			-H 'Content-Type: application/json' \
			-d "$body"
	else
		"$curl_bin" -fsS -X POST "$base_url/v1/messages" \
			-H 'Content-Type: application/json' \
			-d "$body"
	fi
}

stream_events() {
	cursor=$1
	if [ -n "$service_key" ]; then
		"$curl_bin" -fsSN "$base_url/v1/events?cursor=$cursor&follow=true" \
			-H "Authorization: Bearer $service_key"
	else
		"$curl_bin" -fsSN "$base_url/v1/events?cursor=$cursor&follow=true"
	fi
}

case "${1:-}" in
	-h|--help)
		usage
		exit 0
		;;
	"")
		;;
	*)
		usage >&2
		exit 2
		;;
esac

check_curl

count=0
while :; do
	printf 'botified> ' >&2
	if ! IFS= read -r line; then
		printf '\n' >&2
		exit 0
	fi

	case "$line" in
		/quit|/exit)
			exit 0
			;;
		"")
			continue
			;;
	esac

	count=$((count + 1))
	stamp=$(date +%s 2>/dev/null || printf '0')
	client_message_id="botified-chat-$stamp-$$-$count"
	escaped_text=$(printf '%s' "$line" | json_escape)
	body='{"client_message_id":"'"$client_message_id"'","text":"'"$escaped_text"'"}'

	if ! response=$(post_message "$body"); then
		log "message request failed"
		continue
	fi

	cursor=$(printf '%s' "$response" | json_string_field cursor)
	if [ -z "$cursor" ]; then
		log "message response did not include cursor"
		printf '%s\n' "$response" >&2
		continue
	fi

	if ! stream_events "$cursor"; then
		log "event stream failed for cursor $cursor"
	fi
done
